{
  "name": "nimbus-book",
  "version": "1.2.2",
  "private": true,
  "description": "Nimbus Book: an offline business cash book for Android.",
  "scripts": {
    "build": "node build.mjs",
    "sync": "node build.mjs && npx cap sync android",
    "serve": "node build.mjs && npx --yes serve www -l 3000",
